// ====================================================================================
//                             PIPELINE PARAMETERS
// ====================================================================================

params {

    // Default output directory used by derived params when a workflow does not
    // provide --outdir (for example, the NUMT-only workflow launched with -C).
    outdir           = System.getenv('OUTPUT_DIR') ?: '/nfs/roberts/pi/pi_njl27/lt692/primate_results'

    // --- REFERENCE & WDL ---
    ref_dir          = '/home/lt692/scratch_pi_njl27/lt692/primate_mtDNA_analysis/references/variant_calling/Ref_chrM'
    global_ref_dir   = '/home/lt692/scratch_pi_njl27/lt692/primate_mtDNA_analysis/references/variant_calling/Ref_whole'
    // NUMT discovery nuclear-only reference input; this reference set must exclude chrM.
    nuclear_only_ref_dir = System.getenv('NUCLEAR_ONLY_REF_DIR') ?: '/home/lt692/scratch_pi_njl27/lt692/primate_mtDNA_analysis/references/variant_calling/nuclear_only_refs'
    ref_shift_8000_dir = '/home/lt692/scratch_pi_njl27/lt692/primate_mtDNA_analysis/references/variant_calling/Ref_chrM_shift'
    shift_back_chain_dir = '/home/lt692/scratch_pi_njl27/lt692/primate_mtDNA_analysis/references/variant_calling/shift_back_chain'
    ref_interval_dir = '/home/lt692/scratch_pi_njl27/lt692/primate_mtDNA_analysis/references/variant_calling/interval'
    wdl_script       = '/home/lt692/project_pi_njl27/lt692/primate_mt_variant_calling/MitochondriaPipeline_multisample_autoLen.wdl'
    wdl_script_round2= '/home/lt692/project_pi_njl27/lt692/primate_mt_variant_calling/MitochondriaPipeline_multisample_autoLen_round2_NUMT.wdl'

    cram_dirs        = params.outdir
    // Allow launch scripts or direct Nextflow runs to override the Round 1 NUMT BED directory.
    numt_bed_dir     = System.getenv('NUMT_BED_DIR') ?: '/nfs/roberts/pi/pi_njl27/lt692/numt_discovery/primate_results_numt_besthit_strict'
    numt_bed_suffix  = ".highconf_numt.bed"
    consensus_numt_dir = null
    consensus_numt_suffix = ".consensus_numt.fa"
    numt_ref_dir = null
    numt_fasta_suffix = ".original_numt.fa"
    strict_numt_ref = true
    // Minimum genotype depth for mtSwirl-like NUMT hard filtering before consensus construction.
    hc_dp_lower_bound = 10

    round1_outdir = params.outdir
    round1_bam_subdir = "candidate_reads"
    round1_bam_suffix = ".with_mates.bam"

    // mtDNA calls from the cleaned chrM CRAM (not the decoy-coordinate NUMT calls).
    round1_vcf_subdir = "round_1/mtdna_variant_calling"
    round1_vcf_suffix = ".numt_decoy.clean.final.split.vcf"

    consensus_min_af = 0.95
    consensus_min_dp =  100
    consensus_filter_expr = "FMT/AF>=${params.consensus_min_af} && FMT/DP>=${params.consensus_min_dp}"


    // Full-contig nuclear coverage; optional mtcn_nuclear_ref_dir must match existing WGS CRAMs.
    mtcn_nuclear_min_contig_len = 50000
    mtcn_nuclear_target_fraction = 0.90
    mtcn_nuclear_ref_dir = null

    // Round 2 chrM-assigned BAM ambiguity filter switch.
    // 1: enable the QNAME-level XS/AS ambiguity filter.
    // 2: disable this filter and pass retained primary chrM alignments through.
    round2_chrm_assignment_filter = 2

    // Official WDL interval files do not use buffer/padding.
    mt_interval_padding = 0
    mt_left_margin = 575
    mt_right_margin = 545

    // --- TOOLS ---
    cromwell_jar     = '/home/lt692/project_pi_njl27/lt692/cromwell-90.jar'
    picard_jar       = '/home/lt692/project_pi_njl27/lt692/picard.jar'
    haplocheck_jar   = '/home/lt692/project_pi_njl27/lt692/haplocheckCLI-master/haplocheckCLI.jar'
    gatk_jar         = '/home/lt692/project_pi_njl27/lt692/gatk-4.6.2.0/gatk-package-4.6.2.0-local.jar'
    mosdepth_bin     = '/home/lt692/project_pi_njl27/lt692/primate_mt_variant_calling/mosdepth'
    // This binary is used by the coordinator (not a process beforeScript).
    samtools_bin     = System.getenv('SAMTOOLS_BIN') ?: 'samtools'
    skip_existing_cram = true
    force_reprocess_existing_cram = false
    backfill_existing_cram_marker = true
    // Deprecated for fast existing-CRAM validation; retained for CLI compatibility.
    existing_cram_check_retries = 1
    existing_cram_check_delay_seconds = 0
    existing_cram_min_size_bytes = 1024
    existing_crai_min_size_bytes = 16
    existing_cram_quickcheck_retries = 1
    existing_cram_quickcheck_delay_seconds = 0
    existing_cram_quickcheck_timeout_seconds = 120

    // --- SHIFTING PARAMETERS ---
    mt_nc_start      = 576
    mt_right_pad     = 545
    mt_shift         = 8000

    // --- CROMWELL LOCAL BACKEND CONFIGURATION ---
    // Local Cromwell backend is intentional here because Nextflow already runs each sample as a Slurm job.
    // This avoids nested Slurm submission for each WDL task.
    cromwell_config  = "${projectDir}/cromwell_local.conf"
    cromwell_options = [
        runtime_minutes: 1440,
        cpus: 1,
        memory: 5120,
        queue: ''
    ]

    cromwell_submit_rate_limit = 150

    // ENA FASTQ download stability knobs used by DOWNLOAD_FASTQ_RUN.
    download_run_max_forks = 2
    aria2_connections = 4
    aria2_splits = 4
    aria2_fallback_connections = 1
    aria2_fallback_splits = 1
    aria2_fallback_retry_wait = 60
    max_download_attempts = 2

    // Chunked alignment defaults for very large FASTQ runs.
    enable_chunked_alignment = (
        System.getenv('ENABLE_CHUNKED_ALIGNMENT') == null
            ? true
            : System.getenv('ENABLE_CHUNKED_ALIGNMENT').toString().toLowerCase() in ['1', 'true', 'yes', 'y']
    )
    chunked_alignment_size_threshold_gb = 20
    fastq_chunk_reads = 25000000
    align_chunk_cpus = 8
    align_sort_threads = 4
    align_sort_mem_per_thread = '2G'
    cleanup_chunk_intermediates = false // deprecated streaming fallback only; never clean task caches

    // NUMT discovery / best-hit environment. Processes with label `numt_related`
    // run this beforeScript so NUMT tools are configured by Nextflow config, not
    // by numt_detection/load_numt_modules.sh. Override this block in site-specific
    // configs when module names differ.
    numt_env_before_script = '''
        set -euo pipefail

        module purge
        module load miniconda/24.11.3
        module load BWA/0.7.18-GCCcore-13.3.0
        module load SAMtools/1.21-GCC-13.3.0
        module load BEDTools/2.31.1-GCC-13.3.0

        source "$(conda info --base)/etc/profile.d/conda.sh"
        conda activate /home/lt692/.conda/envs/blast_env

        export CONDA_PREFIX="/home/lt692/.conda/envs/blast_env"
        export PATH="${CONDA_PREFIX}/bin:${PATH}"
        export PYTHON_BIN="${CONDA_PREFIX}/bin/python"

        echo "[NUMT ENV] CONDA_PREFIX=${CONDA_PREFIX}"
        echo "[NUMT ENV] PATH=${PATH}"
        echo "[NUMT ENV] python=$(command -v python || true)"
        echo "[NUMT ENV] PYTHON_BIN=${PYTHON_BIN}"

        "${PYTHON_BIN}" -V
        "${PYTHON_BIN}" -c "import pysam; print('[NUMT ENV] pysam', pysam.__version__)"

        echo "[NUMT ENV] bwa=$(command -v bwa || true)"
        bwa 2>&1 | head -n 1 || true

        echo "[NUMT ENV] blastn=$(command -v blastn || true)"
        blastn -version | head -n 1

        echo "[NUMT ENV] makeblastdb=$(command -v makeblastdb || true)"
        makeblastdb -version | head -n 1

        echo "[NUMT ENV] samtools=$(command -v samtools || true)"
        samtools --version | head -n 1

        echo "[NUMT ENV] bedtools=$(command -v bedtools || true)"
        bedtools --version

        for x in python bwa blastn makeblastdb samtools bedtools; do
          command -v "$x" >/dev/null 2>&1 || {
            echo "ERROR: required NUMT command not found: $x" >&2
            echo "PATH=$PATH" >&2
            exit 1
          }
        done
    '''


}

// Allow batch launchers to reuse their fixed per-batch metadata paths after a
// failed or partial run. Scientific workflow outputs are not affected.
trace {
    overwrite = true
}

report {
    overwrite = true
}

timeline {
    overwrite = true
}

// ====================================================================================
//                             PROCESS & EXECUTOR
// ====================================================================================

profiles {

  cluster {

    // ----- Global process defaults for this profile (apply to all tasks) -----
    process {
      executor = 'slurm'             // run every task on Slurm


    withLabel: down_task {
      cpus   = 8
      memory = '8.GB'
      time   = '12h'
      maxForks = 5
      // Load only what these steps need
      beforeScript = """
        module purge
        module load SRA-Toolkit/3.2.0-gompi-2024a
      """
    }

    // Run transfers have their own conservative fan-out; metadata resolution
    // is not counted against this network concurrency limit.
    withName: DOWNLOAD_FASTQ_RUN {
      cpus = 8
      memory = '8.GB'
      time = '12h'
      maxForks = params.download_run_max_forks
    }

    // ------------------------- GROUP 1: alignment/CRAM -----------------------
    withLabel: alignment_related {
      cpus   = 8
      time   = '24h'

      memory = { 64.GB * task.attempt }

      // Retry node/preemption/filesystem-related alignment failures, including missing .exitcode.
      errorStrategy = 'retry'
      maxRetries = 2
      maxForks = 10
      // Load only what these steps need
      beforeScript = """
        module purge
        module load BWA/0.7.18-GCCcore-13.3.0
        module load SAMtools/1.21-GCC-13.3.0
        module load BEDTools/2.31.1-GCC-13.3.0
        module load BCFtools/1.21-GCC-13.3.0
        module load Java/17.0.4
        echo "[NF] bwa:      \$(which bwa)"
        echo "[NF] samtools: \$(which samtools)"
        echo "[NF] SLURM_JOB_ID=\${SLURM_JOB_ID:-}"
        echo "[NF] HOSTNAME=\$(hostname)"
      """
    }




    // Deprecated fallback: the default workflow never invokes this process.
    withName: ALIGN_LARGE_FASTQ_STREAMING_CHUNKS {
      cpus = 8
      memory = '32.GB'
      time = '48h'
      errorStrategy = 'retry'
      maxRetries = 2
      maxForks = 2

      beforeScript = """
        module purge
        module load BWA/0.7.17-GCCcore-12.2.0
        module load SAMtools/1.21-GCC-12.2.0
        module load pigz/2.7-GCCcore-12.2.0
        module load Python/3.10.8-GCCcore-12.2.0
        echo "[NF] bwa:      \$(which bwa)"
        echo "[NF] samtools: \$(which samtools)"
        echo "[NF] pigz:     \$(which pigz)"
        echo "[NF] python:   \$(which python)"
        pigz --version || true
      """
    }

    withName: SPLIT_FASTQ_CHUNKS {
      cpus = 4
      memory = '8.GB'
      time = '24h'
      errorStrategy = 'retry'
      maxRetries = 2
      maxForks = 1

      beforeScript = """
        module purge
        module load pigz/2.7-GCCcore-12.2.0
        echo "[NF] pigz: \$(which pigz)"
        pigz --version
      """
    }

    withName: ALIGN_AND_SORT_CHUNK {
      cpus = params.align_chunk_cpus
      memory = { 32.GB * task.attempt }
      time = { 12.h * task.attempt }
      errorStrategy = 'retry'
      maxRetries = 2
      maxForks = 6
    }

    withName: MERGE_RUN_CHUNK_BAMS {
      cpus = 4
      memory = { 24.GB * task.attempt }
      time = { 12.h * task.attempt }
      errorStrategy = 'retry'
      maxRetries = 2
      maxForks = 2
    }

    withLabel: merge_related {
      cpus   = 8
      memory = { 32.GB * task.attempt }
      time   = { 24.h * task.attempt }

      errorStrategy = { task.exitStatus in [137, 140, 143] ? 'retry' : 'finish' }
      maxRetries = 1
      // Load only what these steps need
      beforeScript = """
        module purge
        module load BWA/0.7.18-GCCcore-13.3.0
        module load SAMtools/1.21-GCC-13.3.0
        echo "[NF] bwa:      \$(which bwa)"
        echo "[NF] samtools: \$(which samtools)"
      """
    }


    // ------------------- GROUP 2: tiny helpers / JSON/TSV gen ----------------
    withLabel: generation_related {
      cpus   = 1
      memory = '1.GB'
      time   = '1h'
      beforeScript = """
        module purge
        module load Python/3.12.3-GCCcore-13.3.0
        module load SAMtools/1.21-GCC-13.3.0
        module load BCFtools/1.21-GCC-13.3.0
        module load HTSlib/1.21-GCC-13.3.0
        module load Java/17.0.4
        echo "[NF] python: \$(which python)"
      """
    }

    // ------------- GROUP 3: GATK/WDL running ----------
    withLabel: wdl_related {
      cpus   = 8
      memory = '32.GB'
      time   = '24h'

      errorStrategy = { task.exitStatus in [1, 137, 140, 143] ? 'retry' : 'terminate' }
      maxRetries = 2

      beforeScript = """
        module purge
        module load BWA/0.7.18-GCCcore-13.3.0
        module load SAMtools/1.21-GCC-13.3.0
        module load BCFtools/1.21-GCC-13.3.0
        module load HTSlib/1.21-GCC-13.3.0
        module load Java/17.0.4
        module load Python/3.12.3-GCCcore-13.3.0
        module load R/4.4.2
        echo "[NF] bwa:      \$(which bwa)"
        echo "[NF] samtools: \$(which samtools)"
        echo "[NF] bcftools: \$(which bcftools)"
        echo "[NF] java: \$(which java)"; java -version
      """
    }

    // --------------------- NUMT discovery / best-hit ---------------------
    withLabel: numt_related {
      cpus   = 8
      memory = '32.GB'
      time   = '12h'
      beforeScript = params.numt_env_before_script

      errorStrategy = 'retry'
      maxRetries = 2
    }

    withName: RUN_WDL_VARIANT_CALLING {
      cpus = 8
      memory = '32.GB'
      time = '24h'
      errorStrategy = { task.exitStatus in [1, 137, 140, 143] ? 'retry' : 'terminate' }
      maxRetries = 2
    }

    withName: CALL_NUMT_VARIANTS_DECOY {
      cpus = 8
      memory = '32.GB'
      time = '24h'
      errorStrategy = { task.exitStatus in [1, 137, 140, 143] ? 'retry' : 'terminate' }
      maxRetries = 2
    }

    }
  }
}
executor {
    queueSize = 40
    submitRateLimit = '180/h'
    exitReadTimeout = '30 min'
}
